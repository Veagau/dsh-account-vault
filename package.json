{
  "name": "@local/dsh-account-vault",
  "version": "2.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Encrypted account and password vault for the DeepSeek Harness Web UI, with decoy vaults opened by separate master passwords.",
  "repository": { "type": "git", "url": "https://github.com/Veagau/dsh-account-vault.git" },
  "bugs": { "url": "https://github.com/Veagau/dsh-account-vault/issues" },
  "homepage": "https://github.com/Veagau/dsh-account-vault#readme",
  "keywords": ["deepseek-harness", "dsh", "plugin", "account-vault", "password-manager"],
  "scripts": { "check": "node scripts/check.mjs" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
